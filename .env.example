# List every environment variable the project needs, with NO real values.
# Real values go in .env (local), Supabase Edge Function secrets, Codemagic variables or GitHub secrets.

# --- Flutter app (optional --dart-define overrides; defaults point at the production project) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Edge Function secrets (set with `supabase secrets set`, never in git) ---
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.
# ANTHROPIC_API_KEY=            # milestone 3, only used from Edge Functions

# --- CI / deploy (GitHub secrets) ---
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# --- Codemagic (encrypted variables / integration, milestone 6) ---
# App Store Connect API key: issuer id, key id, .p8 file (added as a Codemagic integration)
